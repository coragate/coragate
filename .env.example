# Dataplane listen address. Cluster host default 0.0.0.0:8080; client host default 127.0.0.1:8080.
# CORAGATE_LISTEN=

# OpenAI-compatible upstream base (required to proxy). e.g. https://api.openai.com or http://127.0.0.1:8000/v1.
# CORAGATE_UPSTREAM_BASE_URL=

# Policy: enforce (default, block on hit) or observe (detect and audit, do not block on hit).
# CORAGATE_POLICY_MODE=enforce

# Rule snapshot JSON (includes schema_version). Reloaded on a short poll, or POST /v1/reload.
# CORAGATE_RULES_PATH=data/rules.json
# CORAGATE_RULES_POLL=1s

# Seed snapshot only when the rules file does not exist. After that the file wins.
# CORAGATE_DETECT_PATTERN=(?i)coragate-block-me
# CORAGATE_DETECT_RULE_ID=demo-keyword

# Audit JSONL (default file adapter; unflushed queue is lost on crash).
# CORAGATE_AUDIT_PATH=data/audit.jsonl

# Detection engine unavailable: default fail_open (forward and audit engine_error). Only explicit fail_closed rejects.
# CORAGATE_FAIL_MODE=fail_open
