# 数据面监听。集群宿主默认 0.0.0.0:8080；本机宿主默认 127.0.0.1:8080。
# CORAGATE_LISTEN=

# OpenAI 兼容上游根地址（必填才能代理）。可为 https://api.openai.com 或 http://127.0.0.1:8000/v1。
# CORAGATE_UPSTREAM_BASE_URL=

# 策略：enforce（默认，命中阻断）或 observe（检测并审计，但不因命中阻断）。
# CORAGATE_POLICY_MODE=enforce

# 规则快照（JSON，含 schema_version）。改文件后短轮询加载，或 POST /v1/reload。
# CORAGATE_RULES_PATH=data/rules.json
# CORAGATE_RULES_POLL=1s

# 仅当规则文件不存在时作为种子写入快照。之后以文件为准。
# CORAGATE_DETECT_PATTERN=(?i)coragate-block-me
# CORAGATE_DETECT_RULE_ID=demo-keyword

# 审计 JSONL（默认文件适配器；进程崩溃会丢未 flush 的内存队列）。
# CORAGATE_AUDIT_PATH=data/audit.jsonl

# 检测引擎不可用：默认 fail_open（放行并审计 engine_error）。仅显式 fail_closed 才拒绝。
# CORAGATE_FAIL_MODE=fail_open
